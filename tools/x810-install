@dataclass
class InstallBundle:
    archive: Path
    sha256: str
    size_bytes: int
    version: str


def latest_release(opener=urllib.request.urlopen) -> dict[str, Any]:
    request = urllib.request.Request(RELEASE_API, headers={
        "Accept": "application/vnd.github+json",
        "User-Agent": INSTALLER_USER_AGENT,
    })
    try:
        with opener(request, timeout=30) as response:
            payload = response.read(4 * 1024 * 1024 + 1)
    except urllib.error.HTTPError as error:
        raise ValueError(f"GitHub release lookup failed with HTTP {error.code}") from error
    except (OSError, urllib.error.URLError, TimeoutError) as error:
        raise ValueError(f"could not query the latest Arch release: {error}") from error
    if len(payload) > 4 * 1024 * 1024:
        raise ValueError("GitHub release metadata exceeds 4 MiB")
    try:
        release = json.loads(payload)
    except (UnicodeError, json.JSONDecodeError) as error:
        raise ValueError(f"GitHub returned invalid release metadata: {error}") from error
    if not isinstance(release, dict):
        raise ValueError("GitHub returned an unexpected release response")
    return release


def _asset_index(release: dict[str, Any]) -> dict[str, dict[str, Any]]:
    assets = release.get("assets")
    if not isinstance(assets, list):
        raise ValueError("latest Arch release has no assets")
    result: dict[str, dict[str, Any]] = {}
    for asset in assets:
        if not isinstance(asset, dict) or not isinstance(asset.get("name"), str):
            continue
        if asset["name"] in result:
            raise ValueError(f"duplicate GitHub release asset {asset['name']}")
        result[asset["name"]] = asset
    return result


def _release_manifest(release: dict[str, Any], opener=urllib.request.urlopen) -> tuple[dict[str, Any], dict[str, dict[str, Any]]]:
    tag = release.get("tag_name")
    if not isinstance(tag, str) or not re.fullmatch(r"x810-arch-build-[0-9]+", tag):
        raise ValueError("latest release is not a published X810 Arch build")
    assets = _asset_index(release)
    manifest_asset = assets.get("manifest.json")
    if manifest_asset is None:
        raise ValueError("latest Arch release has no manifest.json")
    url = manifest_asset.get("browser_download_url")
    size = manifest_asset.get("size")
    api_digest = manifest_asset.get("digest")
    if (not isinstance(url, str) or not url.startswith("https://github.com/")
            or not isinstance(size, int) or isinstance(size, bool) or not 0 < size <= 16 * 1024 * 1024):
        raise ValueError("release manifest download metadata is invalid")
    request = urllib.request.Request(url, headers={"User-Agent": INSTALLER_USER_AGENT})
    try:
        with opener(request, timeout=90) as response:
            data = response.read(size + 1)
    except (OSError, urllib.error.URLError, TimeoutError) as error:
        raise ValueError(f"could not download release manifest: {error}") from error
    if len(data) != size:
        raise ValueError("downloaded release manifest has the wrong size")
    digest = hashlib.sha256(data).hexdigest()
    if isinstance(api_digest, str) and api_digest.startswith("sha256:") and digest != api_digest[7:]:
        raise ValueError("downloaded manifest does not match GitHub's asset digest")
    try:
        manifest = json.loads(data)
    except (UnicodeError, json.JSONDecodeError) as error:
        raise ValueError(f"release manifest is invalid JSON: {error}") from error
    if (not isinstance(manifest, dict) or isinstance(manifest.get("schema_version"), bool)
            or manifest.get("schema_version") != 1
            or manifest.get("type") != RELEASE_TYPE
            or manifest.get("release_tag") != tag
            or manifest.get("device") != {"model": EXPECTED_MODEL, "codename": "gts9pwifi"}
            or manifest.get("os") != {"id": "archarm", "arch": "aarch64"}
            or manifest.get("kernel_release") != EXPECTED_KERNEL_RELEASE):
        raise ValueError("release manifest is not for this X810 Arch build")
    rootfs = manifest.get("rootfs")
    if not isinstance(rootfs, dict) or rootfs.get("archive") != "rootfs.tar.zst":
        raise ValueError("release manifest does not identify rootfs.tar.zst")
    rootfs_size = rootfs.get("size_bytes")
    rootfs_digest = rootfs.get("sha256")
    if (not isinstance(rootfs_size, int) or isinstance(rootfs_size, bool) or rootfs_size <= 0
            or not isinstance(rootfs_digest, str) or not re.fullmatch(r"[0-9a-f]{64}", rootfs_digest)):
        raise ValueError("release manifest rootfs size or SHA-256 is invalid")
    rootfs_asset = assets.get("rootfs.tar.zst")
    rootfs_asset_size = rootfs_asset.get("size") if rootfs_asset else None
    if (rootfs_asset is None or not isinstance(rootfs_asset_size, int)
            or isinstance(rootfs_asset_size, bool) or rootfs_asset_size != rootfs_size
            or rootfs_asset.get("digest") not in (None, f"sha256:{rootfs_digest}")
            or not isinstance(rootfs_asset.get("browser_download_url"), str)
            or not rootfs_asset["browser_download_url"].startswith("https://github.com/")):
        raise ValueError("rootfs asset metadata disagrees with the release manifest")
    return manifest, assets


def _download_release_asset(asset: dict[str, Any], digest: str, size: int,
                            destination: Path, opener=urllib.request.urlopen) -> Path:
    if destination.is_symlink():
        raise ValueError(f"refusing symlinked release cache file: {destination}")
    destination.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    destination.parent.chmod(0o700)
    if destination.is_file() and destination.stat().st_size == size and sha256_file(destination) == digest:
        return destination
    temp = destination.with_name(f".{destination.name}.partial-{os.getpid()}")
    if temp.exists() or temp.is_symlink():
        temp.unlink()
    request = urllib.request.Request(asset["browser_download_url"], headers={"User-Agent": INSTALLER_USER_AGENT})
    hasher = hashlib.sha256()
    count = 0
    print(f"Downloading {destination.name} ({size:,} bytes)...", flush=True)
    try:
        with opener(request, timeout=120) as response, temp.open("xb") as output_file:
            while True:
                block = response.read(4 * 1024 * 1024)
                if not block:
                    break
                count += len(block)
                if count > size:
                    raise ValueError(f"downloaded {destination.name} exceeds manifest size")
                hasher.update(block)
                output_file.write(block)
        if count != size or hasher.hexdigest() != digest:
            raise ValueError(f"downloaded {destination.name} failed size/SHA-256 verification")
        os.chmod(temp, 0o600)
        os.replace(temp, destination)
    finally:
        if temp.exists():
            temp.unlink()
    return destination


def _verify_archive(project: Path, archive: Path, digest: str, size: int, version: str,
                    runner: Callable[..., subprocess.CompletedProcess[str]] = command) -> InstallBundle:
    if archive.is_symlink() or not archive.is_file():
        raise ValueError("release rootfs cache is missing or unsafe")
    if archive.stat().st_size != size or sha256_file(archive) != digest:
        raise ValueError("cached rootfs size/SHA-256 does not match its release manifest")
    verifier = project / "tools" / "verify-rootfs-archive.py"
    if verifier.is_symlink() or not verifier.is_file():
        raise ValueError("rootfs archive verifier is missing or unsafe")
    verified = runner([sys.executable, str(verifier), str(archive)], timeout=1800)
    if verified.returncode != 0:
        raise ValueError(f"rootfs content/metadata validation failed: {output(verified)}")
    return InstallBundle(archive=archive, sha256=digest, size_bytes=size, version=version)


def download_release_install_set(project: Path, release: dict[str, Any], opener=urllib.request.urlopen,
                                 runner: Callable[..., subprocess.CompletedProcess[str]] = command) -> InstallBundle:
    manifest, assets = _release_manifest(release, opener)
    tag = manifest["release_tag"]
    key = hashlib.sha256(tag.encode("utf-8")).hexdigest()[:24]
    cache = RELEASE_CACHE / key
    if cache.is_symlink():
        raise ValueError(f"release cache path must not be a symlink: {cache}")
    cache.mkdir(mode=0o700, parents=True, exist_ok=True)
    cache.chmod(0o700)
    (cache / "manifest.json").write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
    rootfs = manifest["rootfs"]
    archive = _download_release_asset(
        assets["rootfs.tar.zst"], rootfs["sha256"], rootfs["size_bytes"],
        cache / "rootfs.tar.zst", opener,
    )
    (cache / "release.json").write_text(json.dumps({
        "tag_name": tag, "published_at": release.get("published_at", ""),
    }, indent=2) + "\n", encoding="utf-8")
    return _verify_archive(project, archive, rootfs["sha256"], rootfs["size_bytes"], tag, runner)


def find_cached_install_bundle(project: Path,
                               runner: Callable[..., subprocess.CompletedProcess[str]] = command) -> InstallBundle:
    if RELEASE_CACHE.is_symlink() or not RELEASE_CACHE.is_dir():
        raise ValueError("no cached X810 Arch release is available")
    candidates: list[tuple[str, Path, dict[str, Any], dict[str, Any]]] = []
    for cache in RELEASE_CACHE.iterdir():
        if cache.is_symlink() or not cache.is_dir():
            continue
        try:
            manifest = json.loads((cache / "manifest.json").read_text(encoding="utf-8"))
            release = json.loads((cache / "release.json").read_text(encoding="utf-8"))
            if not isinstance(manifest, dict) or not isinstance(release, dict):
                continue
            candidates.append((str(release.get("published_at", "")), cache, manifest, release))
        except (OSError, json.JSONDecodeError):
            continue
    if not candidates:
        raise ValueError("no verified cached X810 Arch release is available")
    for _, cache, manifest, release in sorted(candidates, reverse=True, key=lambda item: item[0]):
        try:
            _validate_cached_manifest(manifest, release.get("tag_name"))
            rootfs = manifest["rootfs"]
            return _verify_archive(project, cache / "rootfs.tar.zst", rootfs["sha256"],
                                   rootfs["size_bytes"], manifest["release_tag"], runner)
        except (OSError, ValueError, KeyError):
            continue
    raise ValueError("cached X810 Arch releases were incomplete or failed verification")


def _validate_cached_manifest(manifest: dict[str, Any], tag: Any) -> None:
    if (isinstance(manifest.get("schema_version"), bool) or manifest.get("schema_version") != 1
            or manifest.get("type") != RELEASE_TYPE
            or manifest.get("release_tag") != tag
            or manifest.get("device") != {"model": EXPECTED_MODEL, "codename": "gts9pwifi"}
            or manifest.get("os") != {"id": "archarm", "arch": "aarch64"}
            or manifest.get("kernel_release") != EXPECTED_KERNEL_RELEASE
            or not isinstance(manifest.get("rootfs"), dict)):
        raise ValueError("cached manifest is not a valid X810 Arch release")
    rootfs = manifest["rootfs"]
    if (rootfs.get("archive") != "rootfs.tar.zst"
            or isinstance(rootfs.get("size_bytes"), bool)
            or not isinstance(rootfs.get("size_bytes"), int) or rootfs["size_bytes"] <= 0
            or not isinstance(rootfs.get("sha256"), str)
            or not re.fullmatch(r"[0-9a-f]{64}", rootfs["sha256"])):
        raise ValueError("cached manifest has invalid rootfs metadata")


class ADBClient(CommonADBClient):
    """Common ADB transport plus the Arch zstd rootfs stream."""

    def stream_rootfs(self, archive: Path, mountpoint: str, timeout: int = 3600) -> None:
        """Decompress on the host; stream tar into TWRP Toybox without staging a huge file."""
        command_text = f"toybox tar -x --numeric-owner -f - -C {shlex.quote(mountpoint)}"
        try:
            decoder = subprocess.Popen(
                ["zstd", "-q", "-dc", str(archive)],
                stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            )
            assert decoder.stdout is not None
            try:
                received = subprocess.run(
                    [self.adb, "-s", self.serial, "exec-in", command_text],
                    stdin=decoder.stdout, text=False, capture_output=True,
                    timeout=timeout, check=False,
                )
            finally:
                decoder.stdout.close()
            decoder_stderr = decoder.stderr.read() if decoder.stderr else b""
            decode_status = decoder.wait(timeout=15)
        except (OSError, subprocess.SubprocessError) as error:
            raise RuntimeError(f"rootfs stream failed: {error}") from error
        if decode_status != 0:
            detail = decoder_stderr.decode(errors="replace").strip()
            raise RuntimeError(detail or f"zstd exited with status {decode_status}")
        if received.returncode != 0:
            detail = received.stderr.decode(errors="replace").strip() or received.stdout.decode(errors="replace").strip()
            raise RuntimeError(detail or f"ADB tar extraction exited with status {received.returncode}")


def twrp_identity(client: ADBClient) -> tuple[dict[str, str], list[Check]]:
    """Apply the shared X810 identity checks and Arch TWRP alias policy."""
    return common_twrp_identity(
        client, "recovery", expected_model=EXPECTED_MODEL,
        codenames=EXPECTED_CODENAMES, bootloader_prefix=EXPECTED_BOOTLOADER_PREFIX,
        model_aliases={EXPECTED_TWRP_ALIAS}, require_bootloader=True,
    )


def _shell_text(result: subprocess.CompletedProcess[str], label: str) -> str:
    if result.returncode != 0:
        raise RuntimeError(f"{label}: {output(result) or f'exited {result.returncode}'}")
    return result.stdout.strip().replace("\r", "")


def validate_partition(client: ADBClient, archive_bytes: int) -> tuple[dict[str, Any], list[Check]]:
    checks: list[Check] = []
    resolved = _shell_text(client.shell("readlink", "-f", LINUXROOT), "resolve linuxroot")
    if resolved != LINUXROOT_NODE:
        raise RuntimeError(f"PARTLABEL=linuxroot resolves to {resolved}, expected {LINUXROOT_NODE}")
    size_text = _shell_text(client.shell("blockdev", "--getsize64", LINUXROOT), "read linuxroot size")
    try:
        size = int(size_text)
    except ValueError as error:
        raise RuntimeError(f"invalid linuxroot byte size: {size_text!r}") from error
    if size < LINUXROOT_MIN_BYTES or size < archive_bytes:
        raise RuntimeError(
            f"linuxroot is too small: {size:,} bytes; minimum is "
            f"{max(LINUXROOT_MIN_BYTES, archive_bytes):,} bytes"
        )
    def blkid_tag(tag: str, description: str) -> str:
        # TWRP's Android Toybox provides blkid as an applet but not as a
        # standalone executable, and its implementation does not support
        # util-linux's `-o value`. Parse its stable TAG="value" output.
        result = _shell_text(client.shell("toybox", "blkid", "-s", tag, LINUXROOT), description)
        values = re.findall(rf'(?:^|\s){re.escape(tag)}="([^"]*)"(?:$|\s)', result)
        if len(values) != 1:
            raise RuntimeError(f"{description}: could not parse Toybox blkid output: {result!r}")
        return values[0]

    label = blkid_tag("LABEL", "read linuxroot label")
    filesystem = blkid_tag("TYPE", "read linuxroot filesystem")
    if label != LINUXROOT_LABEL or filesystem != "ext4":
        raise RuntimeError(f"expected existing ext4 label linuxroot; found label={label!r}, type={filesystem!r}")
    info = _shell_text(client.shell("sgdisk", f"--info={LINUXROOT_PARTITION_NUMBER}", "/dev/block/sda"), "read linuxroot GPT entry")
    parsed_gpt = parse_sgdisk_info(info)
    if parsed_gpt is None or parsed_gpt["name"] != LINUXROOT_LABEL:
        raise RuntimeError("GPT entry 35 is not named linuxroot or could not be parsed")
    if parsed_gpt["type_guid"] != LINUXROOT_TYPE_GUID:
        raise RuntimeError("GPT entry 35 does not have the expected Linux filesystem type GUID")
    mounts = _shell_text(client.shell("cat", "/proc/mounts"), "read active mounts")
    for line in mounts.splitlines():
        fields = line.split()
        if len(fields) >= 2 and fields[0] in {LINUXROOT, LINUXROOT_NODE}:
            raise RuntimeError(f"linuxroot is already mounted at {fields[1]}; refusing to format it")
    facts = {"node": resolved, "size_bytes": size, "label": label, "filesystem": filesystem, "gpt": info}
    checks.extend((
        Check("Target partition", "OK", f"{resolved}, ext4 label={label}, {size:,} bytes"),
        Check("GPT entry", "OK", "entry 35 is Linux filesystem / linuxroot; GPT will not be changed"),
        Check("Mount state", "OK", "target filesystem is not mounted"),
    ))
    return facts, checks


def revalidate_partition_before_format(client: ADBClient, expected: dict[str, Any],
                                       archive_bytes: int) -> dict[str, Any]:
    """Repeat every target check at the destructive boundary and reject drift.

    The earlier preflight happens before prompts and a GPT metadata backup. The
    selected block node must still be the exact same partition when mke2fs is
    about to run; matching only a minimum size would allow a changed symlink or
    resized/replaced entry 35 to redirect the destructive operation.
    """
    current, _ = validate_partition(client, archive_bytes)
    for field in ("node", "size_bytes", "label", "filesystem", "gpt"):
        if current.get(field) != expected.get(field):
            raise RuntimeError(
                f"linuxroot {field.replace('_', ' ')} changed since preflight; "
                "refusing to format"
            )
    return current


def preflight_twrp_tools(client: ADBClient) -> list[Check]:
    required = ("sgdisk", "blockdev", "mke2fs", "e2fsck", "mount", "umount", "sync", "awk", "grep", "readlink", "toybox", "chmod", "chown", "mv", "cp", "mkdir", "rm", "chroot", "dd")
    checks = []
    for tool in required:
        # Quote the complete command string: adb shell concatenates arguments
        # remotely, so an unquoted `sh -c command -v tool` would check only
        # `command` and falsely report missing tools as present.
        command_text = shlex.quote(f"command -v {shlex.quote(tool)}")
        result = client.shell("sh", "-c", command_text)
        if result.returncode == 0:
            checks.append(Check(f"TWRP tool: {tool}", "OK", result.stdout.strip() or "available"))
        else:
            checks.append(Check(f"TWRP tool: {tool}", "STOP", "required for safe rootfs-only install"))
    blkid = client.shell("toybox", "blkid", "-s", "LABEL", LINUXROOT)
    if blkid.returncode == 0:
        checks.append(Check("TWRP tool: blkid", "OK", "Toybox blkid applet"))
    else:
        checks.append(Check("TWRP tool: blkid", "STOP", "Toybox blkid applet is required to inspect linuxroot"))
    return checks


def host_checks(adb: str | None = None) -> list[Check]:
    checks = [Check("Host OS", "OK" if platform.system() == "Linux" else "STOP", platform.system())]
    for program in ("adb", "zstd", "openssl"):
        path = adb if program == "adb" and adb else shutil.which(program)
        checks.append(Check(f"Host tool: {program}", "OK" if path else "STOP", path or "not found"))
    return checks


def show_checks(checks: list[Check]) -> None:
    width = max((len(item.label) for item in checks), default=0)
    for item in checks:
        print(f"[{item.state:5}] {item.label:<{width}}  {item.detail}")


def write_gpt_backup(client: ADBClient, project: Path, identity: dict[str, str],
                     partition: dict[str, Any], bundle: InstallBundle) -> Path:
    """Save only read-only GPT metadata before writing linuxroot (not a data backup)."""
    base = project / "out" / "install-backups"
    if base.is_symlink():
        raise RuntimeError("install-backups must not be a symlink")
    base.mkdir(mode=0o700, parents=True, exist_ok=True)
    os.chmod(base, 0o700)
    stamp = time.strftime("%Y%m%d-%H%M%S") + f"-{int(time.time() * 1_000_000) % 1_000_000:06d}"
    backup = base / f"x810-arch-{stamp}"
    backup.mkdir(mode=0o700)
    token = uuid.uuid4().hex
    remote = f"/tmp/x810-arch-gpt-{token}.bin"
    try:
        result = client.shell("sgdisk", f"--backup={remote}", "/dev/block/sda", timeout=60)
        if result.returncode != 0:
            raise RuntimeError(f"could not capture UFS GPT metadata: {output(result)}")
        local_gpt = backup / "sda-gpt.bin"
        pulled = client.pull(remote, local_gpt, timeout=120)
        if pulled.returncode != 0 or not local_gpt.is_file() or local_gpt.stat().st_size < 1:
            raise RuntimeError(f"could not retrieve GPT metadata backup: {output(pulled)}")
        verify = client.shell("sgdisk", "--verify", "/dev/block/sda", timeout=60)
        if verify.returncode != 0:
            raise RuntimeError(f"read-only GPT verification failed: {output(verify)}")
        listing = client.shell("sgdisk", "--print", "/dev/block/sda", timeout=60)
        if listing.returncode != 0:
            raise RuntimeError(f"could not save GPT listing: {output(listing)}")
        (backup / "sda-gpt.txt").write_text(listing.stdout + verify.stdout + verify.stderr, encoding="utf-8")
        metadata = {
            "schema_version": 1,
            "device_model": EXPECTED_MODEL,
            "recovery_codename": identity.get("device", ""),
            "bootloader": identity.get("bootloader", ""),
            "twrp_version": identity.get("twrp", ""),
            "adb_serial": client.serial,
            "created_local": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
            "rootfs_archive": bundle.archive.name,
            "rootfs_sha256": bundle.sha256,
            "linuxroot": {key: value for key, value in partition.items() if key != "gpt"},
            "gpt_metadata_sha256": sha256_file(local_gpt),
            "scope": "GPT metadata only; Android boot images are tracked separately; no other partition-data or userdata backup",
        }
        (backup / "manifest.json").write_text(json.dumps(metadata, indent=2) + "\n", encoding="utf-8")
        for path in backup.iterdir():
            if path.is_file():
                os.chmod(path, 0o600)
        return backup
    except Exception:
        marker = backup / "INCOMPLETE.txt"
        marker.write_text("Pre-install GPT metadata backup incomplete; do not treat this directory as complete.\n", encoding="utf-8")
        os.chmod(marker, 0o600)
        raise
    finally:
        # This unlinks a file in recovery's RAM tmpfs; it does not touch a block partition.
        client.shell("rm", "-f", remote)


def _write_private_image(path: Path, data: bytes, expected_size: int, description: str) -> str:
    if len(data) != expected_size:
        raise RuntimeError(f"{description}: expected {expected_size:,} bytes, got {len(data):,}")
    path.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    with path.open("xb") as stream:
        stream.write(data)
        stream.flush()
        os.fsync(stream.fileno())
    os.chmod(path, 0o600)
    return sha256_file(path)


def _verify_boot_partition_geometry(client: ADBClient) -> None:
    for name, expected_size in BOOT_IMAGE_SIZES.items():
        partition = f"/dev/block/by-name/{name}"
        resolved = client.shell("readlink", "-f", partition)
        if resolved.returncode != 0 or resolved.stdout.strip() != BOOT_PARTITION_NODES[name]:
            raise RuntimeError(
                f"refusing to read {name}: {partition} resolves to "
                f"{resolved.stdout.strip() or 'unknown'}, expected {BOOT_PARTITION_NODES[name]}"
            )
        size = client.shell("blockdev", "--getsize64", partition)
        if size.returncode != 0 or size.stdout.strip() != str(expected_size):
            raise RuntimeError(
                f"refusing to read {name}: expected {expected_size:,} bytes, "
                f"got {size.stdout.strip() or 'unknown'}"
            )


def _read_android_set_from_existing_rootfs(client: ADBClient, backup: Path) -> dict[str, Path] | None:
    """Copy a previously staged Android boot set from linuxroot without replaying its journal.

    None means every Android image is absent. A partial set, symlink, wrong-size
    image, or inability to make a read-only mount is an error: formatting in
    those states could destroy the only recoverable Android copy.
    """
    mountpoint = f"/tmp/x810-arch-source-{uuid.uuid4().hex}"
    created = client.shell("mkdir", "-p", mountpoint)
    if created.returncode != 0:
        raise RuntimeError(f"could not create old-linuxroot read-only mountpoint: {output(created)}")
    mounted = client.shell("mount", "-t", "ext4", "-o", "ro,noload", LINUXROOT, mountpoint, timeout=60)
    if mounted.returncode != 0:
        client.shell("rm", "-rf", mountpoint)
        raise RuntimeError(
            "could not mount existing linuxroot read-only to preserve its Android boot set; "
            f"refusing to format: {output(mounted)}"
        )
    try:
        mounts = client.shell("cat", "/proc/mounts")
        verified_mount = False
        if mounts.returncode == 0:
            for line in mounts.stdout.splitlines():
                fields = line.split()
                if len(fields) >= 4 and fields[1] == mountpoint and fields[2] == "ext4":
                    options = set(fields[3].split(","))
                    verified_mount = {"ro", "noload"}.issubset(options)
                    break
        if not verified_mount:
            raise RuntimeError("old linuxroot mount is not verified ext4 ro,noload; refusing to inspect or format")

        android_dir = f"{mountpoint}/var/lib/x810-boot-sets/android"
        directory_exists = client.shell("test", "-d", android_dir).returncode == 0
        directory_is_symlink = client.shell("test", "-L", android_dir).returncode == 0
        if directory_is_symlink:
            raise RuntimeError("existing Android boot-set directory is a symlink; refusing to format linuxroot")
        states: dict[str, tuple[bool, bool]] = {}
        for name in BOOT_IMAGE_SIZES:
            path = f"{android_dir}/{name}.img"
            regular = client.shell("test", "-f", path).returncode == 0
            symlink = client.shell("test", "-L", path).returncode == 0
            states[name] = regular, symlink

        if all(not regular and not symlink for regular, symlink in states.values()):
            if directory_exists:
                raise RuntimeError(
                    "existing Android boot-set directory is incomplete; refusing to erase linuxroot"
                )
            return None
        if any(symlink for _, symlink in states.values()) or not all(regular for regular, _ in states.values()):
            raise RuntimeError(
                "existing linuxroot has a partial or symlinked Android boot set; "
                "refusing to erase linuxroot"
            )

        destination = backup / "boot" / "android"
        destination.mkdir(mode=0o700, parents=True, exist_ok=False)
        images: dict[str, Path] = {}
        records: dict[str, dict[str, Any]] = {}
        for name, expected_size in BOOT_IMAGE_SIZES.items():
            remote = f"{android_dir}/{name}.img"
            canonical = client.shell("readlink", "-f", remote)
            expected_path = f"{android_dir}/{name}.img"
            if canonical.returncode != 0 or canonical.stdout.strip() != expected_path:
                raise RuntimeError(f"existing Android {name} image is not a regular file in the expected directory")
            local = destination / f"{name}.img"
            pulled = client.pull(remote, local, timeout=600)
            if pulled.returncode != 0 or not local.is_file():
                raise RuntimeError(f"could not save existing Android {name} image to the host: {output(pulled)}")
            if local.stat().st_size != expected_size:
                raise RuntimeError(
                    f"existing Android {name} image has {local.stat().st_size:,} bytes, "
                    f"expected {expected_size:,}; refusing to format linuxroot"
                )
            os.chmod(local, 0o600)
            images[name] = local
            records[name] = {
                "file": str(local.relative_to(backup)),
                "size_bytes": expected_size,
                "sha256": sha256_file(local),
            }
        _write_android_boot_manifest(backup, "existing-linuxroot", records)
        return images
    finally:
        unmounted = client.shell("umount", mountpoint, timeout=60)
        if unmounted.returncode != 0:
            raise RuntimeError(f"could not unmount old linuxroot read-only source: {output(unmounted)}")
        removed = client.shell("rm", "-rf", mountpoint)
        if removed.returncode != 0:
            raise RuntimeError(f"could not remove temporary source mountpoint: {output(removed)}")


def _write_android_boot_manifest(backup: Path, source: str,
                                 records: dict[str, dict[str, Any]]) -> None:
    if set(records) != set(BOOT_IMAGE_SIZES):
        raise RuntimeError("Android boot backup manifest must contain exactly four approved images")
    manifest = {
        "schema_version": 1,
        "device_model": EXPECTED_MODEL,
        "source": source,
        "scope": "Android boot set: boot, init_boot, vendor_boot, and dtbo only",
        "images": records,
    }
    path = backup / "android-boot-backup-manifest.json"
    path.write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")
    os.chmod(path, 0o600)
    digest = backup / "android-boot-backup-manifest.sha256"
    digest.write_text(f"{sha256_file(path)}  {path.name}\n", encoding="ascii")
    os.chmod(digest, 0o600)


def save_android_boot_set(client: ADBClient, backup: Path,
                          input_func: Callable[[str], str]) -> dict[str, Path]:
    """Preserve Android boot images locally before linuxroot is formatted.

    Prefer the existing staged Android set, since the currently active boot
    partitions may already contain the Linux kernel. For a first install with
    no staged set, require an explicit attestation before treating the current
    boot partitions as Android images.
    """
    images = _read_android_set_from_existing_rootfs(client, backup)
    if images is not None:
        print("Saved the existing staged Android boot set from linuxroot to the host backup.")
        return images

    try:
        entered = input_func(
            "No staged Android boot set exists in linuxroot. Type exactly "
            f"`{ANDROID_BOOT_CONFIRMATION}` only if the current four boot partitions are Android: "
        ).strip()
    except (EOFError, KeyboardInterrupt):
        raise RuntimeError("cancelled before boot backup; linuxroot was not formatted")
    if entered != ANDROID_BOOT_CONFIRMATION:
        raise RuntimeError(
            "Android boot-image confirmation did not match; no Android boot backup was made "
            "and linuxroot must not be formatted"
        )

    _verify_boot_partition_geometry(client)
    destination = backup / "boot" / "android"
    destination.mkdir(mode=0o700, parents=True, exist_ok=False)
    images = {}
    records: dict[str, dict[str, Any]] = {}
    for name, expected_size in BOOT_IMAGE_SIZES.items():
        partition = f"/dev/block/by-name/{name}"
        data = client.read_binary(f"dd if={partition} bs=4M 2>/dev/null", timeout=600)
        local = destination / f"{name}.img"
        digest = _write_private_image(local, data, expected_size, f"current Android {name} backup")
        images[name] = local
        records[name] = {
            "file": str(local.relative_to(backup)),
            "size_bytes": expected_size,
            "sha256": digest,
        }
    _write_android_boot_manifest(backup, "confirmed-current-partitions", records)
    print("Saved all four confirmed Android boot partitions to the host backup.")
    return images


def prompt_install_details(password_reader: Callable[[str], str] = getpass.getpass,
                           input_func: Callable[[str], str] = input) -> dict[str, str]:
    """Collect a fresh-install identity and password, matching the Fedora flow."""
    def prompt_nonempty(label: str, validation: Callable[[str], None]) -> str:
        while True:
            answer = input_func(label).strip()
            try:
                validation(answer)
                return answer
            except ValueError as error:
                print(f"Invalid value: {error}")

    def valid_username(value: str) -> None:
        if not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", value):
            raise ValueError("username must be 1-32 lowercase Linux account characters and start with a letter/underscore")

    def valid_hostname(value: str) -> None:
        if not re.fullmatch(r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?", value):
            raise ValueError("hostname must be a single DNS label of at most 63 letters, digits, or hyphens")

    def valid_full_name(value: str) -> None:
        if (not value or len(value) > 128 or ":" in value or
                any(unicodedata.category(ch).startswith("C") for ch in value)):
            raise ValueError("enter a non-empty name (up to 128 characters) without control characters")

    details: dict[str, str] = {}
    details["full_name"] = prompt_nonempty("Full name: ", valid_full_name)
    details["username"] = prompt_nonempty("Linux username: ", valid_username)
    details["hostname"] = prompt_nonempty("Hostname: ", valid_hostname)
    for _ in range(3):
        first = password_reader("New Arch user password (hidden): ")
        second = password_reader("Repeat password: ")
        if not first or "\n" in first or "\r" in first or "\x00" in first:
            print("Password may not be empty or contain newline or NUL characters.")
        elif first != second:
            print("Passwords do not match.")
        else:
            details["password_hash"] = hash_password(first)
            return details
    raise ValueError("password confirmation failed")


def provision_rootfs_account(client: ADBClient, mountpoint: str, username: str,
                             full_name: str, hostname: str, password_hash: str) -> None:
    """Replace the generic ALARM seed with the installer-selected fresh user."""
    if not re.fullmatch(r"[a-z_][a-z0-9_-]{0,31}", username):
        raise ValueError("invalid username")
    if not re.fullmatch(r"[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?", hostname):
        raise ValueError("invalid hostname")
    if (not full_name or len(full_name) > 128 or ":" in full_name or
            any(unicodedata.category(ch).startswith("C") for ch in full_name)):
        raise ValueError("invalid full name")
    if not password_hash.startswith("$6$") or "\n" in password_hash:
        raise ValueError("invalid SHA-512-crypt password hash")

    # The image is a pristine, credential-free Arch Linux ARM rootfs. Remove
    # its generic UID-1000 `alarm` account on every install, then create the
    # user entered in this run. No previous tablet account or SSH key is kept.
    remote_script = f"""#!/system/bin/sh
set -eu
umask 077
ROOT={shlex.quote(mountpoint)}
SEED={shlex.quote(ALARM_SEED_USERNAME)}
NEW={shlex.quote(username)}
FULL={shlex.quote(full_name)}
HOST={shlex.quote(hostname)}
PASSFILE=/tmp/x810-arch-password-hash
test -f "$ROOT/etc/passwd"
test -f "$ROOT/etc/group"
test -f "$ROOT/etc/shadow"
test -d "$ROOT/etc/ssh/sshd_config.d"
test -d "$ROOT/etc/sudoers.d"
test -d "$ROOT/etc/skel"
test -s "$PASSFILE"
for utility in userdel useradd groupdel getent chpasswd passwd id visudo; do
  test -x "$ROOT/usr/bin/$utility"
done
for group in wheel video audio input storage; do
  chroot "$ROOT" /usr/bin/getent group "$group" >/dev/null
done
awk -F: -v user="$SEED" -v uid={ALARM_SEED_UID} -v home="/home/$SEED" \
  '$3 == uid {{ uid_count++ }} $1 == user && $3 == uid && $4 == uid && $6 == home {{ found++ }} \
   END {{ exit found != 1 || uid_count != 1 }}' "$ROOT/etc/passwd"
awk -F: -v user="$SEED" -v gid={ALARM_SEED_UID} \
  '$3 == gid {{ gid_count++ }} $1 == user && $3 == gid {{ found++ }} \
   END {{ exit found != 1 || gid_count != 1 }}' "$ROOT/etc/group"
if [ "$NEW" != "$SEED" ]; then
  if awk -F: -v user="$NEW" '$1 == user {{ found=1 }} END {{ exit !found }}' "$ROOT/etc/passwd"; then
    echo 'X810_ACCOUNT: requested username collides with an installed system account' >&2
    exit 21
  fi
  if awk -F: -v group="$NEW" '$1 == group {{ found=1 }} END {{ exit !found }}' "$ROOT/etc/group"; then
    echo 'X810_ACCOUNT: requested username conflicts with an installed system group' >&2
    exit 22
  fi
  if [ -e "$ROOT/home/$NEW" ]; then
    echo 'X810_ACCOUNT: requested home directory collides with an installed path' >&2
    exit 23
  fi
fi
chroot "$ROOT" /usr/bin/userdel "$SEED"
rm -rf "$ROOT/home/$SEED"
if chroot "$ROOT" /usr/bin/getent group "$SEED" >/dev/null 2>&1; then
  chroot "$ROOT" /usr/bin/groupdel "$SEED"
fi
chroot "$ROOT" /usr/bin/useradd --create-home --uid {ALARM_SEED_UID} --user-group \
  --groups wheel,video,audio,input,storage --shell /bin/bash --comment "$FULL" "$NEW"
chroot "$ROOT" /usr/bin/chpasswd --encrypted < "$PASSFILE"
chroot "$ROOT" /usr/bin/passwd --lock root
chown -R {ALARM_SEED_UID}:{ALARM_SEED_UID} "$ROOT/home/$NEW"
chmod 0750 "$ROOT/home/$NEW"
printf '%s\\n' 'PasswordAuthentication yes' 'KbdInteractiveAuthentication no' \
  'PermitEmptyPasswords no' 'PermitRootLogin no' "AllowUsers $NEW" \
  > "$ROOT/etc/ssh/sshd_config.d/90-windstation.conf"
printf '%%wheel ALL=(ALL:ALL) ALL\\n' > "$ROOT/etc/sudoers.d/40-windstation"
chmod 0440 "$ROOT/etc/sudoers.d/40-windstation"
printf '%s\\n' "$HOST" > "$ROOT/etc/hostname"
chmod 0644 "$ROOT/etc/hostname"
printf '%s\\n' "127.0.0.1 localhost.localdomain localhost $HOST" \\
  '::1       localhost.localdomain localhost' > "$ROOT/etc/hosts"
chmod 0644 "$ROOT/etc/hosts"
account_ok=0
while IFS=: read -r name passwd uid gid gecos home shell; do
  if [ "$name" = "$NEW" ] && [ "$uid" = {ALARM_SEED_UID} ] && \\
     [ "$gid" = {ALARM_SEED_UID} ] && [ "$gecos" = "$FULL" ] && \\
     [ "$home" = "/home/$NEW" ] && [ "$shell" = /bin/bash ]; then
    account_ok=1
    break
  fi
done < "$ROOT/etc/passwd"
if [ "$account_ok" -ne 1 ] || [ ! -d "$ROOT/home/$NEW" ]; then
  echo 'X810_VERIFY: fresh account or home is missing/invalid' >&2
  exit 31
fi
groups=$(chroot "$ROOT" /usr/bin/id -Gn "$NEW")
for group in wheel video audio input storage; do
  case " $groups " in *" $group "*) ;; *) echo "X810_VERIFY: user lacks $group group" >&2; exit 32 ;; esac
done
grep -Fxq "AllowUsers $NEW" "$ROOT/etc/ssh/sshd_config.d/90-windstation.conf"
grep -Fxq '%wheel ALL=(ALL:ALL) ALL' "$ROOT/etc/sudoers.d/40-windstation"
grep -Fxq "$HOST" "$ROOT/etc/hostname"
chroot "$ROOT" /usr/bin/visudo -c
"""
    with tempfile.TemporaryDirectory(prefix="x810-arch-provision-") as temporary:
        stage = Path(temporary)
        script = stage / "provision.sh"
        secret = stage / "password-hash"
        script.write_text(remote_script, encoding="utf-8")
        secret.write_text(f"{username}:{password_hash}\n", encoding="ascii")
        os.chmod(script, 0o600)
        os.chmod(secret, 0o600)
        for source, target in ((script, "/tmp/x810-arch-provision.sh"),
                               (secret, "/tmp/x810-arch-password-hash")):
            result = client.push(source, target)
            if result.returncode != 0:
                raise RuntimeError(f"could not stage fresh-account provisioner in TWRP: {output(result)}")
            mode = client.shell("chmod", "0600", target)
            if mode.returncode != 0:
                raise RuntimeError("could not protect temporary account-provisioning files in TWRP")
        try:
            result = client.shell("sh", "/tmp/x810-arch-provision.sh", timeout=120)
            if result.returncode != 0:
                raise RuntimeError(output(result) or "could not create the fresh Arch login account")
        finally:
            client.shell("rm", "-f", "/tmp/x810-arch-provision.sh", "/tmp/x810-arch-password-hash")

def stage_android_boot_set(client: ADBClient, mountpoint: str,
                           images: dict[str, Path]) -> None:
    """Seed and read-back-verify the saved Android boot set in the new rootfs."""
    if set(images) != set(BOOT_IMAGE_SIZES):
        raise ValueError("Android boot set must contain exactly boot/init_boot/vendor_boot/dtbo")
    directory = f"{mountpoint}/var/lib/x810-boot-sets/android"
    base = f"{mountpoint}/var/lib/x810-boot-sets"
    for args in (("mkdir", "-p", directory), ("chmod", "0755", base),
                 ("chmod", "0755", directory)):
        result = client.shell(*args, timeout=60)
        if result.returncode != 0:
            raise RuntimeError(f"could not prepare Android boot-set directory: {output(result)}")
    for name, expected_size in BOOT_IMAGE_SIZES.items():
        source = Path(images[name])
        if source.is_symlink() or not source.is_file() or source.stat().st_size != expected_size:
            raise RuntimeError(f"saved Android {name} image is missing or has the wrong size")
        expected_hash = sha256_file(source)
        destination = f"{directory}/{name}.img"
        pushed = client.push(source, destination, timeout=600)
        if pushed.returncode != 0:
            raise RuntimeError(f"could not stage Android {name} image: {output(pushed)}")
        mode = client.shell("chmod", "0644", destination)
        if mode.returncode != 0:
            raise RuntimeError(f"could not set permissions on staged Android {name} image: {output(mode)}")
        readback = client.read_binary(f"cat {shlex.quote(destination)}", timeout=600)
        if len(readback) != expected_size or hashlib.sha256(readback).hexdigest() != expected_hash:
            raise RuntimeError(f"staged Android {name} image failed read-back verification")

    with tempfile.TemporaryDirectory(prefix="x810-android-boot-label-") as temporary:
        label = Path(temporary) / "name.txt"
        label.write_text("Android\n", encoding="ascii")
        os.chmod(label, 0o600)
        target = f"{directory}/name.txt"
        pushed = client.push(label, target, timeout=30)
        if pushed.returncode != 0:
            raise RuntimeError(f"could not stage Android boot-set label: {output(pushed)}")
        mode = client.shell("chmod", "0644", target)
        if mode.returncode != 0:
            raise RuntimeError(f"could not set permissions on Android boot-set label: {output(mode)}")
        if client.read_binary(f"cat {shlex.quote(target)}", timeout=30) != b"Android\n":
            raise RuntimeError("staged Android boot-set label failed read-back verification")


def verify_extracted_rootfs(client: ADBClient, mountpoint: str) -> None:
    checks = (
        ("test", "-x", f"{mountpoint}/usr/bin/systemctl"),
        ("test", "-f", f"{mountpoint}/usr/lib/modules/{EXPECTED_KERNEL_RELEASE}/modules.dep"),
        ("test", "-f", f"{mountpoint}/usr/lib/systemd/system/gdm.service"),
        ("test", "-x", f"{mountpoint}/usr/bin/gnome-control-center"),
        ("test", "-x", f"{mountpoint}/usr/bin/gnome-session"),
        ("test", "-x", f"{mountpoint}/usr/bin/gnome-terminal"),
        ("test", "-x", f"{mountpoint}/usr/bin/brave"),
        ("test", "-x", f"{mountpoint}/usr/bin/bluetoothctl"),
        ("test", "-f", f"{mountpoint}/usr/lib/systemd/system/bluetooth.service"),
        ("test", "-L", f"{mountpoint}/etc/systemd/system/bluetooth.target.wants/bluetooth.service"),
        ("test", "-x", f"{mountpoint}/usr/bin/tab-companion"),
        ("test", "-x", f"{mountpoint}/usr/local/libexec/x810-boot-switch-core"),
        ("test", "-x", f"{mountpoint}/usr/local/libexec/tab-companion-boot-status"),
        ("test", "-x", f"{mountpoint}/usr/local/libexec/tab-companion-boot-switch"),
        ("test", "-f", f"{mountpoint}/usr/share/gnome-shell/extensions/dualboot@agcarbajo.github.io/extension.js"),
        ("test", "-f", f"{mountpoint}/usr/share/gnome-shell/extensions/dualboot@agcarbajo.github.io/metadata.json"),
        ("test", "-L", f"{mountpoint}/etc/systemd/system/display-manager.service"),
        ("test", "-f", f"{mountpoint}/usr/lib/systemd/system/graphical.target"),
        ("test", "-f", f"{mountpoint}/var/lib/x810-boot-sets/android/name.txt"),
    )
    for name in BOOT_IMAGE_SIZES:
        checks += (("test", "-f", f"{mountpoint}/var/lib/x810-boot-sets/android/{name}.img"),)
    for check in checks:
        result = client.shell(*check)
        if result.returncode != 0:
            raise RuntimeError(f"post-extraction check failed: {' '.join(check)}")
    default = client.shell("readlink", f"{mountpoint}/etc/systemd/system/default.target")
    if default.returncode != 0 or "graphical.target" not in default.stdout:
        raise RuntimeError("post-extraction check failed: default target is not graphical.target")
    bluetooth = client.shell(
        "readlink", f"{mountpoint}/etc/systemd/system/bluetooth.target.wants/bluetooth.service"
    )
    if bluetooth.returncode != 0 or "bluetooth.service" not in bluetooth.stdout:
        raise RuntimeError("post-extraction check failed: bluetooth.service is not enabled")
    auto_enable = client.shell(
        "grep", "-Fxq", "AutoEnable=true", f"{mountpoint}/etc/bluetooth/main.conf"
    )
    if auto_enable.returncode != 0:
        raise RuntimeError("post-extraction check failed: BlueZ AutoEnable=true is missing")
    manager = client.shell("readlink", f"{mountpoint}/etc/systemd/system/display-manager.service")
    if manager.returncode != 0 or "gdm.service" not in manager.stdout:
        raise RuntimeError("post-extraction check failed: display-manager.service is not GDM")
    wants_display_manager = client.shell(
        "grep", "-Fq", "Wants=display-manager.service",
        f"{mountpoint}/usr/lib/systemd/system/graphical.target",
    )
    if wants_display_manager.returncode != 0:
        raise RuntimeError("post-extraction check failed: graphical.target does not pull in display-manager.service")
    os_release = client.shell("grep", "-Fxq", "ID=archarm", f"{mountpoint}/etc/os-release")
    if os_release.returncode != 0:
        raise RuntimeError("post-extraction check failed: rootfs is not Arch Linux ARM")

    label = client.read_binary(
        f"cat {shlex.quote(f'{mountpoint}/var/lib/x810-boot-sets/android/name.txt')}", timeout=30
    )
    if label != b"Android\n":
        raise RuntimeError("post-extraction check failed: Android boot-set label is incorrect")


def format_and_install(client: ADBClient, bundle: InstallBundle, backup: Path,
                       account_details: dict[str, str], expected_partition: dict[str, Any],
                       android_images: dict[str, Path]) -> None:
    # Re-resolve the PARTLABEL, inspect its exact capacity, ext4 identity,
    # GPT entry, and mount state immediately before the only block write.
    revalidate_partition_before_format(client, expected_partition, bundle.size_bytes)
    makefs = client.shell(*linuxroot_format_args(), timeout=600)
    if makefs.returncode != 0:
        raise RuntimeError(f"formatting only {LINUXROOT} failed: {output(makefs)}")
    mkdir = client.shell("mkdir", "-p", INSTALL_MOUNT)
    if mkdir.returncode != 0:
        raise RuntimeError(f"could not create temporary recovery mountpoint: {output(mkdir)}")
    mounted = client.shell("mount", "-t", "ext4", LINUXROOT, INSTALL_MOUNT, timeout=60)
    if mounted.returncode != 0:
        raise RuntimeError(f"could not mount linuxroot after format: {output(mounted)}")
    try:
        client.stream_rootfs(bundle.archive, INSTALL_MOUNT)
        provision_rootfs_account(
            client, INSTALL_MOUNT, account_details["username"],
            account_details["full_name"], account_details["hostname"],
            account_details["password_hash"],
        )
        stage_android_boot_set(client, INSTALL_MOUNT, android_images)
        sync = client.shell("sync", timeout=120)
        if sync.returncode != 0:
            raise RuntimeError("sync after rootfs extraction failed")
    finally:
        unmounted = client.shell("umount", INSTALL_MOUNT, timeout=120)
        if unmounted.returncode != 0:
            raise RuntimeError(f"could not unmount linuxroot; remain in TWRP: {output(unmounted)}")
    check = client.shell("e2fsck", "-f", "-n", LINUXROOT, timeout=900)
    if check.returncode != 0:
        raise RuntimeError(f"read-only e2fsck did not pass; remain in TWRP: {output(check)}")
    remount = client.shell("mount", "-t", "ext4", "-o", "ro", LINUXROOT, INSTALL_MOUNT, timeout=60)
    if remount.returncode != 0:
        raise RuntimeError(f"could not mount linuxroot read-only for verification: {output(remount)}")
    try:
        verify_extracted_rootfs(client, INSTALL_MOUNT)
    finally:
        unmounted = client.shell("umount", INSTALL_MOUNT, timeout=120)
        if unmounted.returncode != 0:
            raise RuntimeError(f"could not unmount verified linuxroot; remain in TWRP: {output(unmounted)}")
    sync = client.shell("sync", timeout=120)
    if sync.returncode != 0:
        raise RuntimeError("final sync failed")
    (backup / "INSTALL-COMPLETE.txt").write_text(
        "Arch rootfs installed and read-back checked. Only PARTLABEL=linuxroot was formatted/written. "
        "The four-image Android boot set was saved under boot/android/ and staged with size/SHA-256 "
        "read-back verification at /var/lib/x810-boot-sets/android/. No Android partition, GPT, "
        "boot image, recovery, vbmeta, userdata, or firmware was modified. No reboot was performed.\n",
        encoding="utf-8",
    )
    os.chmod(backup / "INSTALL-COMPLETE.txt", 0o600)


def linuxroot_format_args() -> tuple[str, ...]:
    """The installer has one explicit block-write command, scoped to linuxroot."""
    return ("mke2fs", "-F", "-t", "ext4", "-L", LINUXROOT_LABEL, "-m", "0", LINUXROOT)


def print_plan(bundle: InstallBundle, partition: dict[str, Any]) -> None:
    print("\nArch Linux ARM on Windstation (SM-X810) — rootfs-only installation plan")
    print(f"  Rootfs artifact: {bundle.archive.name} ({bundle.size_bytes:,} bytes)")
    print(f"  SHA-256: {bundle.sha256}")
    print(f"  Target: {partition['node']} ({partition['size_bytes']:,} bytes), ext4 label=linuxroot")
    print("  Rootfs profile: GNOME Shell + GDM + Tab Companion + matching X810 kernel modules")
    print("  Block write: format only /dev/block/by-name/linuxroot as ext4")
    print("  Boot backup: preserve Android boot/init_boot/vendor_boot/dtbo and stage verified copies in the new rootfs")
    print("  First install: if no Android set is already staged, current boot images require an explicit Android confirmation")
    print("  Never written: GPT, userdata, super, boot, init_boot, vendor_boot, dtbo, recovery, vbmeta, firmware")
    print("  Reboot: none; the installer stops in TWRP")
    print("  Backup: host-side sda GPT metadata + four Android boot images; not a full partition/data backup")


def run_doctor(serial: str | None = None,
               runner: Callable[..., subprocess.CompletedProcess[str]] = command) -> int:
    adb = shutil.which("adb")
    checks = host_checks(adb)
    show_checks(checks)
    if any(item.state == "STOP" for item in checks):
        return 2
    try:
        target, _ = adb_target(adb or "adb", serial, runner)
        client = ADBClient(adb or "adb", target, runner)
        _, identity_checks = twrp_identity(client)
        show_checks(identity_checks)
        tools = preflight_twrp_tools(client)
        show_checks(tools)
        if any(item.state == "STOP" for item in identity_checks + tools):
            return 2
        facts, partition_checks = validate_partition(client, 0)
        show_checks(partition_checks)
        return 0 if facts and not any(item.state == "STOP" for item in partition_checks) else 2
    except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as error:
        print(f"DOCTOR STOPPED: {error}", file=sys.stderr)
        return 2


def run_install(project: Path, bundle: InstallBundle, serial: str | None = None,
                plan_only: bool = False,
                runner: Callable[..., subprocess.CompletedProcess[str]] = command,
                password_reader: Callable[[str], str] = getpass.getpass,
                input_func: Callable[[str], str] = input) -> int:
    if platform.system() != "Linux":
        print("STOP: this installer requires a Linux host.")
        return 2
    adb = shutil.which("adb")
    checks = host_checks(adb)
    show_checks(checks)
    if any(item.state == "STOP" for item in checks):
        return 2
    try:
        target, _ = adb_target(adb or "adb", serial, runner)
        client = ADBClient(adb or "adb", target, runner)
        values, identity_checks = twrp_identity(client)
        show_checks(identity_checks)
        if any(item.state == "STOP" for item in identity_checks):
            print("STOP: TWRP identity/root checks failed; no tablet writes were made.")
            return 2
        tool_checks = preflight_twrp_tools(client)
        show_checks(tool_checks)
        if any(item.state == "STOP" for item in tool_checks):
            print("STOP: TWRP is missing a required utility; no tablet writes were made.")
            return 2
        partition, partition_checks = validate_partition(client, bundle.size_bytes)
        show_checks(partition_checks)
        print_plan(bundle, partition)
        if plan_only:
            print("PLAN ONLY: no GPT backup or tablet writes performed.")
            return 0
        account_details = prompt_install_details(password_reader, input_func)
        try:
            entered = input_func(f"Type exactly `{INSTALL_CONFIRMATION}` to continue: ").strip()
        except (EOFError, KeyboardInterrupt):
            print("Cancelled; no tablet changes were made.")
            return 1
        if entered != INSTALL_CONFIRMATION:
            print("Confirmation did not match; no tablet changes were made.")
            return 1
        backup = write_gpt_backup(client, project, values, partition, bundle)
        print(f"Read-only GPT metadata backup saved to {backup}.")
        android_images = save_android_boot_set(client, backup, input_func)
        print(f"Verified Android boot images saved locally under {backup / 'boot' / 'android'}.")
        try:
            entered = input_func(f"Type exactly `{FORMAT_CONFIRMATION}` to format linuxroot: ").strip()
        except (EOFError, KeyboardInterrupt):
            print("Cancelled; linuxroot was not formatted. GPT and Android boot backups retained.")
            return 1
        if entered != FORMAT_CONFIRMATION:
            print("Confirmation did not match; linuxroot was not formatted. GPT and Android boot backups retained.")
            return 1
        format_and_install(client, bundle, backup, account_details, partition, android_images)
        print(f"\nArch rootfs extracted, fresh {account_details['username']} account created, and read-only filesystem verification passed.")
        print(f"Install record / GPT and Android boot backups: {backup}")
        print("No reboot was performed. Manually choose when to leave TWRP after reviewing the result.")
        return 0
    except (OSError, RuntimeError, ValueError, subprocess.SubprocessError, EOFError, KeyboardInterrupt) as error:
        print(f"INSTALL STOPPED: {error}", file=sys.stderr)
        print("No automatic reboot was attempted. If formatting/extraction began, remain in TWRP and rerun only after reviewing the failure.", file=sys.stderr)
        return 2


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Fetch and safely install the latest verified X810 Arch GNOME/GDM release from an already-open TWRP session."
    )
    parser.add_argument("command", nargs="?", choices=("install", "doctor"), default="install",
                        help="install the latest GitHub release (default), or perform read-only host/TWRP checks")
    parser.add_argument("--serial", help="select this ADB serial if multiple devices are connected")
    parser.add_argument("--no-update", action="store_true",
                        help="use the newest verified release already cached locally; do not query GitHub")
    parser.add_argument("--plan-only", action="store_true", help="verify target and show the plan; do not create backup or write tablet")
    args = parser.parse_args()
    project = Path(__file__).resolve().parents[1]
    if args.command == "doctor":
        if args.no_update or args.plan_only:
            parser.error("doctor does not accept --no-update or --plan-only")
        return run_doctor(args.serial)
    if not args.plan_only and not (sys.stdin.isatty() and sys.stdout.isatty()):
        print("STOP: install requires an interactive terminal for hidden password entry and typed confirmations.", file=sys.stderr)
        return 2
    try:
        if args.no_update:
            bundle = find_cached_install_bundle(project)
            print(f"Verified cached GitHub release {bundle.version}; no network request was made.", flush=True)
        else:
            release = latest_release()
            bundle = download_release_install_set(project, release)
            print(f"Verified GitHub release {bundle.version}; SHA-256 {bundle.sha256}.", flush=True)
    except (OSError, ValueError, subprocess.SubprocessError) as error:
        print(f"INSTALL STOPPED: release download/verification failed: {error}", file=sys.stderr)
        return 2
    return run_install(project, bundle, args.serial, args.plan_only)


if __name__ == "__main__":
    raise SystemExit(main())
