# SPDX-License-Identifier: MIT
pkgname=x810-device-support
pkgver=0.1.1
pkgrel=1
pkgdesc='Device controls and Qualcomm SSC sensors for Samsung Galaxy Tab S9+ Wi-Fi (SM-X810)'
arch=('aarch64')
url='https://github.com/iamSlightlyWind/x810-btwdroid'
license=('MIT' 'GPL-3.0-only' 'BSD-3-Clause' 'custom:Qualcomm')
install='x810-device-support.install'
provides=('iio-sensor-proxy=3.9')
conflicts=('iio-sensor-proxy')
replaces=('iio-sensor-proxy')
depends=('systemd' 'python' 'zram-generator' 'dbus' 'wpa_supplicant' 'dtc' 'tuned-ppd'
  'device-mapper' 'libqmi' 'libqrtr-glib' 'protobuf-c' 'glib2' 'libgudev' 'polkit')
options=('!strip' '!debug')
backup=(
  'etc/x810-thermal-limit.json'
  'etc/x810-power-profile-tuning.json'
  'etc/systemd/zram-generator.conf.d/80-x810.conf'
)

package() {
  cp -a "$startdir/files/." "$pkgdir/"
  install -Dm0644 "$startdir/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm0644 "$startdir/licenses/GPL-3.0.txt" \
    "$pkgdir/usr/share/licenses/$pkgname/GPL-3.0.txt"
  install -Dm0644 "$startdir/licenses/pd-mapper-BSD-3-Clause.txt" \
    "$pkgdir/usr/share/licenses/$pkgname/pd-mapper-BSD-3-Clause.txt"
  install -Dm0644 "$startdir/licenses/qrtr-BSD-3-Clause.txt" \
    "$pkgdir/usr/share/licenses/$pkgname/qrtr-BSD-3-Clause.txt"
  install -Dm0644 "$startdir/licenses/LICENSE.qcom.txt" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE.qcom.txt"
}
