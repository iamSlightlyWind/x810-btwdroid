# SPDX-License-Identifier: MIT

enable_sensor_units() {
  systemctl --root=/ enable \
    gts9wifi-android-parts.service vendor.mount vendor-firmware_mnt.mount \
    vendor-dsp.mount mnt-vendor-persist.mount gts9wifi-wait-sensor-proxy.timer \
    gts9wifi-audio-session.timer \
    || return 1
}

prepare_sensor_account() {
  if command -v systemd-sysusers >/dev/null 2>&1; then
    systemd-sysusers /usr/lib/sysusers.d/hexagonrpcd.conf || return 1
  fi
}

post_install() {
  cat <<'NOTICE'
x810-device-support installed. The delayed X810 audio/sensor timers and the
read-only Android vendor/firmware/DSP/persist mounts are enabled. They start
asynchronously after GDM; the stock APNHLOS ADSP image is staged from its
read-only mount when ADSP startup runs. Other device services retain image-profile
enablement policy.
NOTICE
  prepare_sensor_account && enable_sensor_units
}

post_upgrade() {
  prepare_sensor_account && enable_sensor_units
}
