# SPDX-License-Identifier: MIT

enable_device_units() {
  systemctl --root=/ enable \
    gts9wifi-android-parts.service vendor.mount vendor-firmware_mnt.mount \
    vendor-dsp.mount mnt-vendor-persist.mount gts9wifi-wait-sensor-proxy.timer \
    gts9wifi-audio-session.timer gts9wifi-panel-coldboot-recover.service \
    getty@tty3.service \
    || return 1
}

prepare_sensor_account() {
  if command -v systemd-sysusers >/dev/null 2>&1; then
    systemd-sysusers /usr/lib/sysusers.d/hexagonrpcd.conf || return 1
  fi
}

post_install() {
  cat <<'NOTICE'
x810-device-support installed. The X810 cold-boot panel recovery, delayed
audio/sensor timers, VT3 text console, and read-only Android mounts are
enabled. The panel recovery runs before GDM; audio/sensor work is deferred.
NOTICE
  prepare_sensor_account && enable_device_units && systemctl daemon-reload
}

post_upgrade() {
  prepare_sensor_account && enable_device_units && systemctl daemon-reload
}
